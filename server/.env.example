# =====================================================================
# LOOP & LOVE BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# =====================================================================

PORT=5000
NODE_ENV=production

# Managed PostgreSQL Connection String (Render / Railway / Neon / Supabase)
# Example: postgres://username:password@ep-host.region.aws.neon.tech/loop_and_love?sslmode=require
DATABASE_URL=postgres://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]

# JWT Authentication Secrets (Generate secure random 64-char strings)
JWT_SECRET=[GENERATE_SECURE_RANDOM_SECRET_KEY]
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=[GENERATE_SECURE_ADMIN_SECRET_KEY]

# Allowed Frontend Origins (Comma separated URLs)
CORS_ORIGIN=https://loop-and-love.vercel.app,http://localhost:3000

# Razorpay Indian Payment Gateway Credentials (Leave empty for Test Mode)
RAZORPAY_KEY_ID=[RZP_KEY_ID_PLACEHOLDER]
RAZORPAY_KEY_SECRET=[RZP_KEY_SECRET_PLACEHOLDER]
RAZORPAY_WEBHOOK_SECRET=[RZP_WEBHOOK_SECRET_PLACEHOLDER]
IS_PAYMENT_TEST_MODE=true

# Shipping & Delivery Thresholds (INR ₹)
FREE_SHIPPING_THRESHOLD=1499
STANDARD_SHIPPING_FEE=79

# Studio Contact Information
SUPPORT_EMAIL=care@loopandlove.in
SUPPORT_WHATSAPP=+91 98765 43210

